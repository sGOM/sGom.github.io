---
import { getCollection, render } from 'astro:content';
import PostLayout from '../../layouts/PostLayout.astro';
import SeriesNav from '../../components/SeriesNav.astro';
import { filterDrafts, getSeriesPosts } from '../../lib/posts';

export async function getStaticPaths() {
  const all = await getCollection('posts');
  const posts = filterDrafts(all, import.meta.env.DEV);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post, siblings: post.data.series ? getSeriesPosts(posts, post.data.series) : [] },
  }));
}

const { post, siblings } = Astro.props;
const { Content } = await render(post);
const series = post.data.series;
---

<PostLayout post={post}>
  {series && (
    <SeriesNav
      slot="series-top"
      series={series}
      posts={siblings}
      current={post}
      position="top"
    />
  )}
  <Content />
  {series && (
    <SeriesNav
      slot="series-bottom"
      series={series}
      posts={siblings}
      current={post}
      position="bottom"
    />
  )}
</PostLayout>
