---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import CategoryList from '../components/CategoryList.astro';
import PostCard from '../components/PostCard.astro';

interface Props {
  title: string;
  description: string;
  /** 목록 위에 노출할 제목. 홈에서는 생략한다 */
  heading?: string;
  posts: CollectionEntry<'posts'>[];
  categories: { category: string; count: number }[];
  total: number;
  /** 현재 카테고리. 홈이면 넘기지 않는다 */
  current?: string;
}

const { title, description, heading, posts, categories, total, current } =
  Astro.props;
---

<BaseLayout title={title} description={description} wide>
  <div class="list-layout">
    <div class="list-aside">
      <CategoryList categories={categories} total={total} current={current} />
    </div>
    <div class="list-main">
      {heading && <h1>{heading}</h1>}
      {posts.length === 0 && <p>아직 글이 없습니다.</p>}
      {posts.map((post) => <PostCard post={post} />)}
    </div>
  </div>
</BaseLayout>

<style>
  /* 좌측 카테고리 + 우측 목록. 목록은 남는 폭을 모두 쓰되
     .container--wide 가 전체 폭을 제한한다 */
  .list-layout {
    display: grid;
    grid-template-columns: var(--aside-width) minmax(0, 1fr);
    gap: 3rem;
    align-items: start;
  }
  .list-main {
    min-width: 0;
  }
  h1 {
    margin-top: 0;
  }

  /* 사이드바를 유지하기 애매해지는 폭부터는 한 단으로 접고,
     카테고리를 목록 위에 가로로 늘어놓는다 (DOM 순서 그대로) */
  @media (max-width: 899px) {
    .list-layout {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }
  }
</style>
