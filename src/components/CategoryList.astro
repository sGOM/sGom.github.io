---
interface Props {
  categories: { category: string; count: number }[];
  total: number;
  /** 현재 보고 있는 카테고리. 홈(전체보기)이면 넘기지 않는다 */
  current?: string;
}

const { categories, total, current } = Astro.props;
---

<aside class="category-list" data-pagefind-ignore aria-label="카테고리">
  <ul>
    <li>
      <a href="/" class:list={[current === undefined && 'is-current']}>
        전체보기 <span class="count">({total})</span>
      </a>
    </li>
    {categories.map(({ category, count }) => (
      <li>
        <a
          href={`/categories/${encodeURIComponent(category)}/`}
          class:list={[current === category && 'is-current']}
        >
          {category} <span class="count">({count})</span>
        </a>
      </li>
    ))}
  </ul>
</aside>

<style>
  .category-list {
    position: sticky;
    top: 5.5rem;
    align-self: start;
    max-height: calc(100vh - 7rem);
    overflow-y: auto;
    font-size: 0.9rem;
  }

  ul {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    color: var(--fg-muted);
  }

  a:hover {
    color: var(--fg);
  }

  .is-current {
    color: var(--fg);
    font-weight: 700;
  }

  .count {
    font-size: 0.8rem;
  }

  /* 좁은 화면에서는 본문 위로 접어 올린다 */
  @media (max-width: 899px) {
    .category-list {
      position: static;
      max-height: none;
      margin-bottom: 2rem;
      padding-bottom: 1.5rem;
      border-bottom: 1px solid var(--border);
    }
    ul {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 0.5rem 1rem;
    }
  }
</style>
