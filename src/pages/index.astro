---
import { getCollection } from 'astro:content';
import ListLayout from '../layouts/ListLayout.astro';
import { sortByDate, filterDrafts, collectCategories } from '../lib/posts';

const all = await getCollection('posts');
const visible = filterDrafts(all, import.meta.env.DEV);
const posts = sortByDate(visible);
---

<ListLayout
  title="sGOM"
  description="개발하며 겪은 문제와 공부한 개념을 남깁니다"
  posts={posts}
  categories={collectCategories(visible)}
  total={visible.length}
/>
