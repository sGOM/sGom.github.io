---
import type { CollectionEntry } from 'astro:content';
import { getSeriesNeighbors } from '../lib/posts';

interface Props {
  series: string;
  posts: CollectionEntry<'posts'>[];
  current: CollectionEntry<'posts'>;
  position: 'top' | 'bottom';
}

const { series, posts, current, position } = Astro.props;
const { prev, next } = getSeriesNeighbors(posts, current);
---

{position === 'top' && (
  <details class="toc" data-pagefind-ignore>
    <summary>
      시리즈: <a href={`/series/${encodeURIComponent(series)}/`}>{series}</a>
      <span class="count">({posts.length}편)</span>
    </summary>
    <ol>
      {posts.map((p) => (
        <li aria-current={p.id === current.id ? 'true' : undefined}>
          {p.id === current.id ? (
            <span>{p.data.title}</span>
          ) : (
            <a href={`/posts/${p.id}/`}>{p.data.title}</a>
          )}
        </li>
      ))}
    </ol>
  </details>
)}

{position === 'bottom' && (prev || next) && (
  <nav class="adjacent" data-pagefind-ignore>
    {prev ? (
      <a href={`/posts/${prev.id}/`} class="prev">← {prev.data.title}</a>
    ) : (
      <span />
    )}
    {next && <a href={`/posts/${next.id}/`} class="next">{next.data.title} →</a>}
  </nav>
)}

<style>
  .toc {
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 0.75rem 1rem;
    margin-bottom: 2rem;
    font-size: 0.9rem;
  }
  .toc summary {
    cursor: pointer;
  }
  .count {
    color: var(--fg-muted);
  }
  .toc ol {
    margin: 0.75rem 0 0;
    padding-left: 1.25rem;
  }
  .toc li[aria-current='true'] {
    color: var(--fg-muted);
    font-weight: 700;
  }
  .adjacent {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
    font-size: 0.9rem;
  }
  .adjacent .next {
    margin-left: auto;
    text-align: right;
  }
</style>
