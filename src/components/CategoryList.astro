---
import type { GroupNode } from '../lib/posts';

interface Props {
  groups: GroupNode[];
  total: number;
  /** 현재 위치. 홈(전체보기)이면 넘기지 않는다 */
  current?: { group?: string; category?: string };
}

const { groups, total, current } = Astro.props;
---

<aside class="category-list" data-pagefind-ignore aria-label="글 목록 탐색">
  <ul class="groups">
    <li>
      <a
        href="/"
        class:list={[current === undefined && 'is-current']}
        aria-current={current === undefined ? 'page' : undefined}
      >
        전체보기 <span class="count">({total})</span>
      </a>
    </li>
    {groups.map(({ group, count, categories }) => (
      <li>
        <details
          open
          data-group={group}
          data-current={current?.group === group ? '' : undefined}
        >
          <summary>
            <a
              href={`/groups/${encodeURIComponent(group)}/`}
              class:list={[
                current?.group === group &&
                  current?.category === undefined &&
                  'is-current',
              ]}
              aria-current={
                current?.group === group && current?.category === undefined
                  ? 'page'
                  : undefined
              }
            >
              {group} <span class="count">({count})</span>
            </a>
          </summary>
          {categories.length > 0 && (
            <ul class="categories">
              {categories.map(({ category, count }) => (
                <li>
                  <a
                    href={`/categories/${encodeURIComponent(category)}/${encodeURIComponent(group)}/`}
                    class:list={[
                      current?.group === group &&
                        current?.category === category &&
                        'is-current',
                    ]}
                    aria-current={
                      current?.group === group && current?.category === category
                        ? 'page'
                        : undefined
                    }
                  >
                    {category} <span class="count">({count})</span>
                  </a>
                </li>
              ))}
            </ul>
          )}
        </details>
      </li>
    ))}
  </ul>
</aside>

<script>
  // 접힘 상태를 브라우저에 남긴다. 사이드바 클릭은 곧 페이지 이동이라
  // 저장하지 않으면 매번 다시 펴진다. 현재 보고 있는 그룹은 항상 편다
  for (const el of document.querySelectorAll<HTMLDetailsElement>(
    '.category-list details'
  )) {
    const key = `category-list:${el.dataset.group}`;
    if (el.dataset.current === undefined && localStorage.getItem(key) === '0') {
      el.open = false;
    }
    el.addEventListener('toggle', () =>
      localStorage.setItem(key, el.open ? '1' : '0')
    );
  }
</script>

<style>
  .category-list {
    position: sticky;
    top: 5.5rem;
    align-self: start;
    max-height: calc(100vh - 7rem);
    overflow-y: auto;
    font-size: 0.9rem;
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .groups {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  /* 2-depth. 세로선으로 들여쓰기를 드러낸다 */
  .categories {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin-top: 0.4rem;
    padding-left: 0.75rem;
    border-left: 1px solid var(--border);
  }

  .categories a {
    font-size: 0.85rem;
  }

  summary {
    cursor: pointer;
    list-style-position: inside;
  }

  summary::marker {
    color: var(--fg-muted);
    font-size: 0.75em;
  }

  a {
    color: var(--fg-muted);
  }

  a:hover {
    color: var(--fg);
  }

  .is-current {
    color: var(--fg);
    font-weight: 700;
  }

  .count {
    font-size: 0.8rem;
  }

  /* 좁은 화면에서는 본문 위로 접어 올린다.
     2-depth는 가로로 못 펴므로 그룹마다 한 줄을 차지하고
     그 줄 안에서 하위 카테고리가 가로로 흐른다 */
  @media (max-width: 899px) {
    .category-list {
      position: static;
      max-height: none;
      margin-bottom: 2rem;
      padding-bottom: 1.5rem;
      border-bottom: 1px solid var(--border);
    }
    .groups {
      gap: 0.75rem;
    }
    .groups details {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 0.5rem 1rem;
    }
    .categories {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 0.5rem 1rem;
      margin-top: 0;
      padding-left: 0;
      border-left: 0;
    }
  }
</style>
